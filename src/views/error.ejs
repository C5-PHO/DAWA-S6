<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Social Media</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="shell navigation">
            <a href="/" class="brand" aria-label="Social Media - Inicio">
                <span class="brand-mark">SM</span>
                <span class="brand-copy">
                    <strong>Social Media</strong>
                    <small>Comunidad digital</small>
                </span>
            </a>
        </div>
    </header>

    <main class="shell error-page">
        <section class="error-card">
            <div class="error-symbol">
                <span class="material-icons" aria-hidden="true">error_outline</span>
            </div>
            <p class="eyebrow">Operación interrumpida</p>
            <h1>No se pudo completar la solicitud</h1>
            <p><%= message %></p>
            <a href="/posts" class="action-button">Volver a publicaciones</a>
        </section>
    </main>
</body>
</html>
