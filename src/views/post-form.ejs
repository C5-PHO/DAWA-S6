<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Social Media</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="shell navigation">
            <a href="/" class="brand" aria-label="Social Media - Inicio">
                <span class="brand-mark">SM</span>
                <span class="brand-copy">
                    <strong>Social Media</strong>
                    <small>Comunidad digital</small>
                </span>
            </a>
            <a href="/posts" class="nav-link">Publicaciones</a>
        </div>
    </header>

    <main class="shell form-container">
        <section class="form-card">
            <header class="form-header">
                <p class="eyebrow">Gestión de contenido</p>
                <h1><%= title %></h1>
                <p>Completa los datos para mantener la publicación clara y bien organizada.</p>
            </header>

            <% if (error) { %>
                <div class="notice notice-error" role="alert"><%= error %></div>
            <% } %>

            <% if (users.length === 0) { %>
                <div class="notice notice-warning">Debes registrar al menos un usuario antes de crear publicaciones.</div>
            <% } %>

            <form action="<%= action %>" method="POST">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="title">Título</label>
                        <input id="title" name="title" type="text" value="<%= post.title || '' %>" minlength="5" maxlength="30" required>
                        <span class="helper-text">Entre 5 y 30 caracteres</span>
                    </div>

                    <div class="form-field">
                        <label for="content">Contenido</label>
                        <textarea id="content" name="content" minlength="10" required><%= post.content || '' %></textarea>
                        <span class="helper-text">Mínimo 10 caracteres</span>
                    </div>

                    <div class="form-field">
                        <label for="hashtags">Hashtags</label>
                        <input id="hashtags" name="hashtags" type="text" value="<%= Array.isArray(post.hashtags) ? post.hashtags.join(', ') : (post.hashtags || '') %>">
                        <span class="helper-text">Sepáralos con comas, por ejemplo: nodejs, mongodb</span>
                    </div>

                    <div class="form-field">
                        <label for="imageUrl">URL de la imagen</label>
                        <input id="imageUrl" name="imageUrl" type="url" value="<%= post.imageUrl || '' %>" placeholder="https://ejemplo.com/imagen.jpg">
                    </div>

                    <div class="form-field">
                        <label for="userId">Autor</label>
                        <select id="userId" name="userId" required>
                            <option value="" disabled <%= post.user ? '' : 'selected' %>>Selecciona un autor</option>
                            <% users.forEach((user) => { %>
                                <% const selectedUserId = post.user?._id || post.user || post.userId; %>
                                <option value="<%= user._id %>" <%= String(selectedUserId || '') === String(user._id) ? 'selected' : '' %>>
                                    <%= user.name %> <%= user.lastName %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/posts" class="secondary-button">Cancelar</a>
                    <button type="submit" class="action-button" <%= users.length === 0 ? 'disabled' : '' %>>
                        <%= submitLabel %>
                        <span class="material-icons" aria-hidden="true">arrow_forward</span>
                    </button>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
