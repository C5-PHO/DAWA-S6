<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Media - Posts</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">
    <nav>
        <div class="nav-wrapper teal">
            <a href="/" class="brand-logo center">Social Media</a>
        </div>
    </nav>

    <main class="container">
        <h4 class="center-align">Publicaciones</h4>

        <% if (posts.length === 0) { %>
            <p class="center-align flow-text">Aún no hay publicaciones registradas.</p>
        <% } %>

        <div class="row">
            <% posts.forEach((post) => { %>
                <div class="col s12 m6 l4">
                    <article class="card">
                        <div class="card-image">
                            <img
                                src="<%= post.imageUrl || 'https://media.istockphoto.com/id/627795510/photo/example.jpg?s=612x612&w=0&k=20&c=lpUf5rjPVd6Kl_M6heqC8sUncR4FLmtsRzeYdTr5X_I=' %>"
                                alt="Imagen de la publicación <%= post.title %>"
                            >
                        </div>

                        <div class="card-content">
                            <span class="card-title"><%= post.title %></span>
                            <p><%= post.content %></p>

                            <% if (post.hashtags?.length) { %>
                                <p>
                                    <strong>Hashtags:</strong>
                                    <% post.hashtags.forEach((hashtag) => { %>
                                        <span class="chip"><%= hashtag %></span>
                                    <% }) %>
                                </p>
                            <% } %>
                        </div>

                        <div class="card-action">
                            <div class="right">
                                <a href="#" class="btn-flat" aria-label="Editar publicación">
                                    <i class="material-icons teal-text">edit</i>
                                </a>
                                <a href="#" class="btn-flat" aria-label="Eliminar publicación">
                                    <i class="material-icons red-text">delete</i>
                                </a>
                            </div>
                            <span>
                                <strong>Autor:</strong>
                                <%= post.user ? `${post.user.name} ${post.user.lastName}` : 'Sin autor' %>
                            </span>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
