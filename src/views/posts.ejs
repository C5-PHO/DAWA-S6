<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publicaciones - Social Media</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <div class="shell navigation">
            <a href="/" class="brand" aria-label="Social Media - Inicio">
                <span class="brand-mark">SM</span>
                <span class="brand-copy">
                    <strong>Social Media</strong>
                    <small>Comunidad digital</small>
                </span>
            </a>
            <a href="/" class="nav-link">Inicio</a>
        </div>
    </header>

    <main class="shell content-area">
        <section class="page-heading">
            <div>
                <p class="eyebrow">Comunidad</p>
                <h1>Publicaciones</h1>
                <p>Consulta las ideas compartidas y administra el contenido registrado.</p>
            </div>
            <a href="/posts/new" class="action-button">
                <span class="material-icons" aria-hidden="true">add</span>
                Nueva publicación
            </a>
        </section>

        <% if (posts.length === 0) { %>
            <section class="empty-state">
                <span class="material-icons" aria-hidden="true">inbox</span>
                <h2>Aún no hay publicaciones</h2>
                <p>Crea la primera publicación para comenzar.</p>
            </section>
        <% } %>

        <section class="posts-grid" aria-label="Lista de publicaciones">
            <% posts.forEach((post) => { %>
                <article class="post-card" id="post-<%= post._id %>">
                    <img
                        class="post-image"
                        src="<%= post.imageUrl || '/post-placeholder.svg' %>"
                        alt="Imagen de la publicación <%= post.title %>"
                    >

                    <div class="post-content">
                        <h2><%= post.title %></h2>
                        <p><%= post.content %></p>

                        <% if (post.hashtags?.length) { %>
                            <div class="post-hashtags" aria-label="Hashtags">
                                <% post.hashtags.forEach((hashtag) => { %>
                                    <span class="tag"><%= hashtag %></span>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <footer class="post-footer">
                        <div class="post-author">
                            <strong><%= post.user ? `${post.user.name} ${post.user.lastName}` : 'Sin autor' %></strong>
                            <span class="post-date">
                                <%= post.createdAt ? new Date(post.createdAt).toLocaleDateString('es-PE') : 'Sin fecha' %>
                            </span>
                        </div>

                        <div class="post-actions">
                            <a href="/posts/<%= post._id %>/edit" class="icon-button" aria-label="Editar publicación">
                                <span class="material-icons" aria-hidden="true">edit</span>
                            </a>
                            <form
                                action="/posts/<%= post._id %>/delete"
                                method="POST"
                                onsubmit="return confirm('¿Deseas eliminar esta publicación?');"
                            >
                                <button type="submit" class="icon-button danger" aria-label="Eliminar publicación">
                                    <span class="material-icons" aria-hidden="true">delete</span>
                                </button>
                            </form>
                        </div>
                    </footer>
                </article>
            <% }) %>
        </section>
    </main>
</body>
</html>
